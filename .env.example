# Supabase — Projekt "voulez" (eu-central-1)
SUPABASE_URL=https://kivmcjlrepexusiagtac.supabase.co

# Secret/Service-Role-Key. Dashboard → Project Settings → API Keys → "secret".
# Umgeht RLS. Darf NIEMALS im Client landen und nie ins Repo.
SUPABASE_SERVICE_ROLE_KEY=

# E-Mail-Versand. Plunk → Project settings → API keys, der geheime "sk_"-Key.
# Der öffentliche "pk_"-Key reicht nicht: /v1/send verlangt den geheimen.
PLUNK_API_KEY=

# Absender. Die Domain muss in Plunk verifiziert sein — sonst lehnt die API
# ab und der Tresor wird gar nicht erst angelegt. Die Schreibweise
# "Name <adresse>" bleibt; Plunk bekommt beides getrennt übergeben.
MAIL_FROM="Voulez <post@voulez.love>"

# Basis-URL für Links in E-Mails. In Produktion https://voulez.love
SITE_URL=http://localhost:3000

# HMAC-Secret fuer den "geoeffnet"-Nachweis (Cookie)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Wohin Missbrauchsmeldungen gehen
REPORT_TO=

# Schützt /api/cron/cleanup, den täglichen Lauf, der abgelaufene Tresore und
# die zugehörigen Plunk-Kontakte löscht. Vercel schickt den Wert automatisch
# als Bearer-Token mit. Ohne Wert antwortet der Endpunkt mit 503 und es wird
# nichts aufgeräumt — die 90-Tage-Zusage gilt dann nicht.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
