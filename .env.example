# Supabase — Projekt "voulez" (eu-central-1)
SUPABASE_URL=https://kivmcjlrepexusiagtac.supabase.co

# Secret/Service-Role-Key. Dashboard → Project Settings → API Keys → "secret".
# Umgeht RLS. Darf NIEMALS im Client landen und nie ins Repo.
SUPABASE_SERVICE_ROLE_KEY=

# E-Mail-Versand. Plunk → Project settings → API keys, der geheime "sk_"-Key.
# Der öffentliche "pk_"-Key reicht nicht: /v1/send verlangt den geheimen.
PLUNK_API_KEY=

# Absender. Die Domain muss in Plunk verifiziert sein — sonst lehnt die API
# ab und der Tresor wird gar nicht erst angelegt. Die Schreibweise
# "Name <adresse>" bleibt; Plunk bekommt beides getrennt übergeben.
MAIL_FROM="Voulez <post@voulez.love>"

# Basis-URL für Links in E-Mails. In Produktion https://voulez.love
SITE_URL=http://localhost:3000

# HMAC-Secret fuer den "geoeffnet"-Nachweis (Cookie)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Wohin Missbrauchsmeldungen gehen
REPORT_TO=

# Schützt /api/cron/cleanup, den täglichen Lauf, der abgelaufene Tresore und
# die zugehörigen Plunk-Kontakte löscht. Vercel schickt den Wert automatisch
# als Bearer-Token mit. Ohne Wert antwortet der Endpunkt mit 503 und es wird
# nichts aufgeräumt — die 90-Tage-Zusage gilt dann nicht.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Wallet-Pässe. Beide Blöcke sind optional und werden getrennt geprüft: fehlt
# in einem Block auch nur ein Wert, erscheint der zugehörige Knopf unter dem
# Ticket gar nicht erst. Halb konfiguriert gilt als nicht konfiguriert.
# ---------------------------------------------------------------------------

# Apple Wallet. Braucht eine Mitgliedschaft im Apple Developer Program; das
# Pass-Zertifikat selbst kostet nichts.
#
# Diese fünf Werte tippt man nicht von Hand ab — sie kommen fertig aus
#   ./scripts/apple-pass-env.sh
# Voraussetzung: in certs/ liegen pass-key.pem, pass.csr und wwdr-g4.pem (beim
# Aufsetzen erzeugt), und du hast auf developer.apple.com unter Identifiers →
# Pass Type IDs die Kennung angelegt, mit certs/pass.csr ein Zertifikat
# erzeugt und es als certs/pass.cer abgelegt.
#
# Das Skript prüft dabei zweierlei, was sonst erst auf dem Gerät auffällt:
# ob Zertifikat und Schlüssel zusammengehören, und ob die Zwischenstelle
# wirklich G4 ist — mit G2, G3, G5 oder G6 baut der Pass fehlerfrei und wird
# beim Hinzufügen kommentarlos abgelehnt.
#
# Base64, weil mehrzeiliges PEM in einer Umgebungsvariable nicht überlebt.
APPLE_PASS_TYPE_ID=pass.love.voulez.ticket
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM_BASE64=
APPLE_PASS_KEY_PEM_BASE64=
APPLE_WWDR_CERT_PEM_BASE64=

# Google Wallet. Kostenlos, braucht aber ein Cloud-Projekt mit aktivierter
# Wallet API, einen Service-Account und ein Issuer-Konto aus der Google Pay &
# Wallet Console. Der Service-Account muss dort zusätzlich unter
# "Google Wallet API → Users" mit der Rolle "Developer" eingetragen sein.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLIENT_EMAIL=

# Aus der JSON-Datei des Service-Accounts, Feld "private_key" — mitsamt der
# literalen \n. Der Code setzt sie beim Lesen zurück in echte Zeilenumbrüche.
GOOGLE_WALLET_PRIVATE_KEY=

# Die einmal angelegte Klasse. Anlegen oder aktualisieren mit:
#   node --env-file=.env.local scripts/create-google-class.mjs
GOOGLE_WALLET_CLASS_SUFFIX=voulez_einladung_v1
